//Images during flooding
var duringStart = '2017-08-25';
var duringEnd = '2017-09-05';

//Study area
var geo = geometry; 

//Sentinel collection 
var collection = ee.ImageCollection('COPERNICUS/S1_GRD')
  .filter(ee.Filter.eq('instrumentMode', 'IW'))
  .filter(ee.Filter.listContains('transmitterReceiverPolarisation', 'VV'))
  .filter(ee.Filter.listContains('transmitterReceiverPolarisation', 'VH'))
  .filter(ee.Filter.eq('orbitProperties_pass', 'ASCENDING')) 
  .filter(ee.Filter.eq('resolution_meters', 10))
  .filterBounds(geometry)
  .select(['VV', 'VH']); 

// Making a collection of imagesduring flooding
var duringCollection = collection.filterDate(duringStart, duringEnd);

var during = duringCollection.mean().clip(geometry);

// Mask out areas with permanent/semi-permanent water
var permanentWater = gsw.select('seasonality').gte(5).clip(geometry);
// during = during.updateMask(permanentWater.not());
Map.addLayer(permanentWater.selfMask(), {min: 0, max: 1, palette: ['blue']}, 'Permanent Water');

Map.addLayer(during, {min: -25, max: 0}, 'Before Floods', false);

// Merge traning points together
var newfc = flooded.merge(nonflooded);
print(newfc, 'newfc');

Map.addLayer(newfc)

// Select the bands for training
var bands = ['VV', 'VH'];

// Sample the input imagery to get a FeatureCollection of training data.
var training = during.select(bands).sampleRegions({
  collection: newfc,
  properties: ['LC'],
  scale: 30
});

// Make a Random Forest classifier and train it.
var classifier = ee.Classifier.smileRandomForest(50).train({
  features: training,
  classProperty: 'LC',
  inputProperties: bands
});

// Classify the input imagery.
var classified = during.select(bands).classify(classifier);

// Define a palette for the Land Use classification.
var palette = [
  'D3D3D3', // urban (0)  // grey
  '0000FF', // water (1)  // blue
];

// Display the classification result and the input image.
// Map.addLayer(classified, {min: 0, max: 1, palette: palette}, 'Land Use Classification');

var flood = classified.updateMask(classified.eq(1)); // mask it
Map.addLayer(flood, {}, 'Flooded');

