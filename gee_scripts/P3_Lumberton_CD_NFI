/////////////////////////////////
//Postprocessing
/////////////////////////////////

//Reduce to vector
// Now reduce this integral image to vector
var FloodPolygons = flood.reduceToVectors({
  geometryType: 'polygon',
  reducer: ee.Reducer.countEvery(),
  scale: 20, // Adjust the scale as needed
  maxPixels: 1e8
});

// Map.addLayer(valid_image, {color: 'black'}, 'Valid image');

// Add the vector layer to the map
Map.addLayer(FloodPolygons, {color: 'red'}, 'Flood Polygons');

