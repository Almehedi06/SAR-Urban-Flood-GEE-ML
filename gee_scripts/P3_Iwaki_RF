  .filter(ee.Filter.listContains('transmitterReceiverPolarisation', 'VH'))
  .filter(ee.Filter.eq('orbitProperties_pass', 'ASCENDING'))
  .filter(ee.Filter.eq('resolution_meters', 10))
  .filterBounds(geometry)
  .select('VV', 'VH'); 

// Filter for during flood and dry periods
var duringCollection = collection.filterDate(duringStart, duringEnd);
var dryCollection = collection.filterDate(dryStart, dryEnd);

// Mosaic for during flood and dry periods
var during = duringCollection.mosaic().clip(geometry);
var dry = dryCollection.mosaic().clip(geometry);

// Preprocess the images (filtering and conversion)
var duringFiltered = ee.Image(toDB(RefinedLee(toNatural(during))));
var dryFiltered = ee.Image(toDB(RefinedLee(toNatural(dry))));

// Generate division image
var division = duringFiltered.divide(dryFiltered);

// Define the input features (bands) from Sentinel-1 data and division image
var inputFeatures = duringFiltered.addBands(dryFiltered).addBands(division);

