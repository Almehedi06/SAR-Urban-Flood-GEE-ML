// Function to extract date from an image and convert it to a readable format
function extractDate(image) {
    var date = ee.Date(image.get('system:time_start')).format('YYYY-MM-dd');
    return ee.Feature(null, {'date': date});
}

// Apply the function to each image in the collection
var dates = duringCollection.map(extractDate);

// Print the dates
print('Acquisition dates:', dates.aggregate_array('date'));


