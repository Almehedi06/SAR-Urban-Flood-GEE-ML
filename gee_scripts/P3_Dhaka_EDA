// Calculate the standard deviation image for the dry collection
var dryStdDev = dryCollection.reduce(ee.Reducer.stdDev());

// Clip the standard deviation image to the specified geometry
dryStdDev = dryStdDev.clip(geometry);

// Add the standard deviation image to the map
Map.addLayer(dryStdDev, {min: 0, max: 5}, 'Dry Standard Deviation Image');

//Bivariate mathematical operations////////
// Calculate the difference image
var differenceImage = dry.subtract(during);

// Add the difference image to the map
Map.addLayer(differenceImage, {min: -5, max: 5, palette: ['red', 'white', 'blue']}, 'Difference Image');

// Calculate the image by dividing differenceImage by dryStdDev
var normalizedDifference = differenceImage.divide(dryStdDev);

// Add the normalized difference image to the map
Map.addLayer(normalizedDifference, {min: -2, max: 2, palette: ['red', 'white', 'blue']}, 'Normalized Difference Image');

var normalizedDifferenceHistogram = ui.Chart.image.histogram(normalizedDifference, geometry, 30)
  .setOptions({
    title: 'Translated Dry Image Histogram',
    hAxis: {title: 'Pixel Value'},
    vAxis: {title: 'Frequency'},
  });

print(normalizedDifferenceHistogram);

// Clip pixels below -4 in the standardized difference image
var clippedDifference = normalizedDifference.updateMask(normalizedDifference.gte(2));

// Add the clipped difference image to the map
Map.addLayer(clippedDifference, {min: -2, max: 2, palette: ['red', 'white', 'blue']}, 'Clipped Difference Image');

